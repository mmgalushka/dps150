# Allowlist policy: ignore everything, then explicitly re-include.
# See CONTRIBUTING.md before adding entries.
*

# Git / repo metadata
!/.gitignore
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/DEVOPS.md

# Specs: markdown only
!/spec/
!/spec/*.md

# Scripts: shell only
!/scripts/
!/scripts/*.sh

# Tests: captured binary fixtures and golden UI renderings (for now)
!/tests/
!/tests/fixtures/
!/tests/fixtures/*.bin
!/tests/golden/
!/tests/golden/*.txt

# Rust workspace
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/deny.toml
!/src/
!/src/*.rs
!/crates/
!/crates/*/
!/crates/*/Cargo.toml
!/crates/*/src/
!/crates/*/src/*.rs
!/crates/*/tests/
!/crates/*/tests/*.rs
!/tests/*.rs

# Development entry point
!/helper.sh

# CI workflows
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
