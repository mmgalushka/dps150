# Allowlist policy: ignore everything, then explicitly re-include.
# See CONTRIBUTING.md before adding entries.
*

# Git / repo metadata
!/.gitignore
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/DEVOPS.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/codecov.yml

# README images
!/docs/
!/docs/images/
!/docs/images/*.png

# Specs: markdown only
!/spec/
!/spec/*.md

# Scripts: shell only
!/scripts/
!/scripts/*.sh

# Tests: captured binary fixtures and golden UI renderings (for now)
!/tests/
!/tests/fixtures/
!/tests/fixtures/*.bin
!/tests/golden/
!/tests/golden/*.txt

# Rust workspace
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/deny.toml
!/src/
!/src/*.rs
!/crates/
!/crates/*/
!/crates/*/Cargo.toml
!/crates/*/src/
!/crates/*/src/*.rs
!/crates/*/src/bin/
!/crates/*/src/bin/*.rs
!/crates/*/tests/
!/crates/*/tests/*.rs
!/crates/*/tests/*/
!/crates/*/tests/*/*.rs
!/crates/*/examples/
!/crates/*/examples/*.rs
!/tests/*.rs

# Packaging: maintainer scripts for the .deb
!/packaging/
!/packaging/postinst

# Development entry point
!/helper.sh

# CI workflows
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/dependabot.yml
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml

# cargo-dist configuration
!/dist-workspace.toml
